# M681 audio opt-in fragment.
# Usage: make O=<out> ARCH=arm64 CROSS_COMPILE=... m681_defconfig m681_audio.config
# (or merge_config.sh). Keeps the shipping m681_defconfig audio-off so other
# lanes' builds are unaffected; flip the defconfig only when the maintainer decides
# to make audio default-on.
#
# TRAP (observed twice now): these symbols only EXIST after CONFIG_SND_SOC=y
# is evaluated — hand-editing a live .config that had SND_SOC=n and running
# olddefconfig silently resets MT_SND_SOC_CODEC to "" and NEW_ARCH to n.
# Always apply as a fragment (this file) or re-check the live .config after.
CONFIG_SND_SOC=y
CONFIG_MTK_SND_SOC_NEW_ARCH=y
CONFIG_MT_SND_SOC_CODEC="mt6351"
# BTCVSD (BT SCO voice, AP-side AFE only, no PMIC writes) — re-assert because
# the SND_SOC=n->y transition re-creates it:
CONFIG_MTK_BTCVSD_ALSA=y
# Deliberately OFF (display-safety + not-our-hardware):
# CONFIG_MTK_SPEAKER is not set
# CONFIG_MTK_VOW_SUPPORT is not set
# CONFIG_MTK_OFFLOAD_PLAYBACK is not set
# CONFIG_SND_SOC_RT5509 is not set
# CONFIG_SND_SOC_MAX98926 is not set
